# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# OS / IDE
.DS_Store
.idea/
.vscode/

# --- Large artifacts: do NOT commit (regenerate locally) ---

# Fine-tuned weights (~1.3 GB each). Train with: bash scripts/train_cp2.sh
experiments/checkpoints/*
!experiments/checkpoints/README.md

# Raw downloads (~30 MB CoDocBench). Fetch with: python data/scripts/download_and_preprocess.py
data/raw/

# Processed JSONL (~8 MB). Regenerated by the same download script.
data/processed/

# Model / training binaries
*.safetensors
*.pt
*.pth
training_args.bin
optimizer.pt
scheduler.pt
rng_state.pth

# Eval outputs (regenerate with: bash scripts/run_cp2_eval.sh)
experiments/results/*.json
!experiments/results/.gitkeep

# Caches
.cache/
wandb/
*.arrow
models/
