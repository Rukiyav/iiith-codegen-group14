# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# OS / IDE
.DS_Store
.idea/
.vscode/

# --- Large artifacts: do NOT commit (regenerate locally) ---

# Fine-tuned weights. Train with: python train.py
experiments/checkpoints/*
!experiments/checkpoints/README.md
models/lora_finetuned/
models/baseline/

# RAG index and repo clones (regenerate locally)
data/repo_corpus/
retrieval/vector_store/

# Eval outputs (regenerate with: python -m src.eval)
evaluation/results/*.json
!evaluation/results/.gitkeep
experiments/results/*.json
!experiments/results/.gitkeep

# Raw downloads & preprocessed JSONL files. Fetch with: python train.py
data/raw/
data/processed/

# Model / training binaries
*.safetensors
*.pt
*.pth
training_args.bin
optimizer.pt
scheduler.pt
rng_state.pth

# Caches & temporary archives
.cache/
wandb/
*.arrow
*.zip
